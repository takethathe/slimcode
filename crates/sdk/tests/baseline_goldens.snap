### tool_turn
Observable {
    events: [
        "message(user::weather please;usage=-)",
        "disp:turn(1)",
        "disp:text(checking )",
        "message(assistant::checking ;usage=15)",
        "disp:usage(15)",
        "disp:toolstart(call_1,probe,{})",
        "disp:toolresult(call_1,probe,ok=true,probed)",
        "message(tool::probed;usage=-)",
        "disp:turn(2)",
        "disp:text(done)",
        "message(assistant::done;usage=15)",
        "disp:usage(15)",
        "disp:stop(Completed)",
        "turn_finished(Completed)",
    ],
    stop: Some(
        "Completed",
    ),
    error: None,
    title: Some(
        "weather please",
    ),
    usage_total: 30,
    history: [
        "user::weather please",
        "assistant::checking  [call_1:probe]",
        "tool::probed (for call_1)",
        "assistant::done",
    ],
    log: [
        "<HEADER>",
        "{\"type\":\"title\",\"title\":\"weather please\"}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"text\":\"weather please\"}]}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"checking \"}],\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"probe\",\"arguments\":\"{}\"}]}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"tool\",\"parts\":[{\"type\":\"text\",\"text\":\"probed\"}],\"tool_call_id\":\"call_1\"}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"done\"}]}}",
    ],
}

### error
Observable {
    events: [
        "message(user::hello;usage=-)",
        "disp:turn(1)",
        "disp:text(first)",
        "message(assistant::first;usage=0)",
        "disp:usage(0)",
        "disp:stop(Completed)",
        "turn_finished(Completed)",
        "message(user::boom;usage=-)",
        "disp:turn(1)",
    ],
    stop: Some(
        "Completed",
    ),
    error: Some(
        "provider exploded",
    ),
    title: Some(
        "hello",
    ),
    usage_total: 0,
    history: [
        "user::hello",
        "assistant::first",
        "user::boom",
        "assistant::The turn ended with an error: provider exploded",
    ],
