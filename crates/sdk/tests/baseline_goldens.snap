### skill_intercept
Observable {
    events: [
        "message(user::use the probe skill;usage=-)",
        "disp:turn(1)",
        "message(assistant::;usage=0)",
        "disp:usage(0)",
        "disp:toolstart(call_1,read,{\"path\": \"<HOME>/skills/probe/SKILL.md\"})",
        "disp:toolresult(call_1,read,ok=true,<skill name=\"probe\" location=\"<HOME>/skills/probe/SKILL.md\">\nReferences are relative to <HOME>/skills/probe.\n\nPROBE BODY\n</skill>)",
        "message(tool::<skill name=\"probe\" location=\"<HOME>/skills/probe/SKILL.md\">\nReferences are relative to <HOME>/skills/probe.\n\nPROBE BODY\n</skill>;usage=-)",
        "disp:turn(2)",
        "disp:text(loaded)",
        "message(assistant::loaded;usage=0)",
        "disp:usage(0)",
        "disp:stop(Completed)",
        "turn_finished(Completed)",
    ],
    stop: Some(
        "Completed",
    ),
    error: None,
    title: Some(
        "use the probe skill",
    ),
    usage_total: 0,
    history: [
        "user::use the probe skill",
