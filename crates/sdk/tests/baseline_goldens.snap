        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"\"}],\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"read\",\"arguments\":\"{\\\"path\\\": \\\"<HOME>/skills/probe/SKILL.md\\\"}\"}]}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"tool\",\"parts\":[{\"type\":\"text\",\"text\":\"<skill name=\\\"probe\\\" location=\\\"<HOME>/skills/probe/SKILL.md\\\">\\nReferences are relative to <HOME>/skills/probe.\\n\\nPROBE BODY\\n</skill>\"}],\"tool_call_id\":\"call_1\"}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"loaded\"}]}}",
