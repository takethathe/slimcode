}

### cancel
Observable {
    events: [
        "message(user::go;usage=-)",
        "disp:turn(1)",
        "message(assistant::;usage=0)",
        "disp:usage(0)",
        "disp:toolstart(call_1,probe,{})",
        "disp:toolresult(call_1,probe,ok=true,probed)",
        "message(tool::probed;usage=-)",
        "disp:turn(2)",
        "disp:text(final)",
        "disp:stop(Cancelled)",
        "turn_finished(Cancelled)",
    ],
    stop: Some(
        "Cancelled",
    ),
    error: None,
    title: Some(
        "go",
    ),
    usage_total: 0,
    history: [
        "user::go",
        "assistant:: [call_1:probe]",
        "tool::probed (for call_1)",
        "assistant::The turn was cancelled.",
    ],
    log: [
        "<HEADER>",
        "{\"type\":\"title\",\"title\":\"go\"}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"text\":\"go\"}]}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"\"}],\"tool_calls\":[{\"id\":\"call_1\",\"name\":\"probe\",\"arguments\":\"{}\"}]}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"tool\",\"parts\":[{\"type\":\"text\",\"text\":\"probed\"}],\"tool_call_id\":\"call_1\"}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"The turn was cancelled.\"}]},\"stop_reason\":\"aborted\"}",
    ],
}

### compaction
Observable {
    events: [
        "message(user::<x x 800000>;usage=-)",
        "disp:turn(1)",
        "disp:text(SUMMARY BODY)",
        "message(assistant::SUMMARY BODY;usage=7)",
        "disp:usage(7)",
        "disp:stop(Completed)",
        "turn_finished(Completed)",
        "compacted(200003,6)",
    ],
    stop: Some(
        "Completed",
    ),
    error: None,
    title: Some(
        "<x x 48>…",
    ),
    usage_total: 14,
    history: [
        "user::SUMMARY BODY",
        "assistant::SUMMARY BODY",
    ],
    log: [
        "<HEADER>",
        "{\"type\":\"title\",\"title\":\"<x x 48>…\"}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"text\":\"<x x 800000>\"}]}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"llm\",\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"text\":\"SUMMARY BODY\"}]}}",
        "{\"type\":\"message\",\"message\":{\"kind\":\"compact_summary\",\"summary\":\"SUMMARY BODY\",\"tokens_before\":200003,\"kept_count\":1}}",
    ],
}

