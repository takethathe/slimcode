-/// Build a fresh session with a new id and timestamp.
-pub fn new_session(store: &SessionStore) -> slimcode_agent::session::Session {
-    slimcode_agent::session::Session {
-        id: store.new_id(),
-        created_at: now_rfc3339(),
-        messages: Vec::new(),
-        title: None,
-    }
-}
