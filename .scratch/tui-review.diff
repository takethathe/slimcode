+            "type": "object",
+            "properties": {
+                "command": {"type": "string", "description": "Shell command to run"}
+            },
+            "required": ["command"]
+        }),
+        move |args| {
+            let command = args
+                .get("command")
+                .and_then(Value::as_str)
+                .ok_or_else(|| "bash: missing string `command`".to_string())?;
+            run_shell_cancellable(&cwd, command, &cancel)
