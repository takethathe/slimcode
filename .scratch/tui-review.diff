+        let parts = call("find", serde_json::json!({})).unwrap();
+        assert_eq!(parts_text(&parts), "find . in .");
+    }
+
+    // --- edit / write ------------------------------------------------------
+
+    #[test]
+    fn edit_and_write_titles_name_the_path_in_accent() {
+        let parts = call("edit", serde_json::json!({"path": "a.txt"})).unwrap();
